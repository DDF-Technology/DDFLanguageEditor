{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ddf.technology/schemas/references-lock-1.1.json",
  "title": "DDF external reference lock 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [ "format", "version", "projectModule", "context", "fingerprint", "references" ],
  "properties": {
    "format": { "const": "ddf-external-reference-lock" },
    "version": { "const": "1.1" },
    "projectModule": { "type": "string", "minLength": 1 },
    "context": { "enum": [ "standalone", "embedded" ] },
    "fingerprint": { "$ref": "#/$defs/hash" },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "ownerModule", "id", "kind", "version", "architecture", "origin", "capabilities", "binding", "assemblyPath", "adapterId", "sha256", "size", "apiFingerprint", "dependencies" ],
        "properties": {
          "ownerModule": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": [ "managed-dotnet", "com", "native", "host-service" ] },
          "version": { "type": "string", "minLength": 1 },
          "architecture": { "enum": [ "any", "x86", "x64", "arm64" ] },
          "origin": { "enum": [ "project", "configured", "system", "host" ] },
          "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "binding": { "enum": [ "managed-assembly", "typed-adapter" ] },
          "assemblyPath": { "type": "string" },
          "adapterId": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^(?:[0-9a-f]{64})?$" },
          "size": { "type": "integer", "minimum": 0 },
          "apiFingerprint": { "$ref": "#/$defs/hash" },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "id", "version", "path", "sha256", "size" ],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "$ref": "#/$defs/hash" },
                "size": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ddf.technology/schemas/project-1.2.json",
  "title": "DDF project manifest 1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [ "schemaVersion", "name", "module", "languageId", "languagePackageVersion", "sources", "entryPoint", "dependencies", "references", "backend", "output", "options" ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.2" },
    "name": { "type": "string", "minLength": 1 },
    "module": {
      "type": "object", "additionalProperties": false,
      "required": [ "id", "version", "exports" ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}$" },
        "exports": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" } }
      }
    },
    "languageId": { "$ref": "#/$defs/id" },
    "languagePackageVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}$" },
    "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "entrySource": { "type": [ "string", "null" ] },
    "entryPoint": { "$ref": "#/$defs/name" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": [ "id", "version" ],
        "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "minLength": 1 } }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [ "id", "kind", "version", "architecture", "origin", "capabilities" ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": [ "managed-dotnet", "com", "native", "host-service" ] },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}$" },
          "architecture": { "enum": [ "any", "x86", "x64", "arm64" ] },
          "origin": { "enum": [ "project", "configured", "system", "host" ] },
          "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "host-service" } } }, "then": { "properties": { "origin": { "const": "host" } } } },
          { "if": { "properties": { "kind": { "enum": [ "com", "native" ] } } }, "then": { "properties": { "architecture": { "enum": [ "x86", "x64", "arm64" ] } } } }
        ]
      }
    },
    "backend": { "const": "ddf-vm-ir-v1" },
    "output": {
      "type": "object", "additionalProperties": false, "required": [ "directory", "artifact" ],
      "properties": { "directory": { "type": "string", "minLength": 1 }, "artifact": { "type": "string", "minLength": 1 } }
    },
    "options": {
      "type": "object", "additionalProperties": false, "required": [ "useUnsavedBuffers" ],
      "properties": { "useUnsavedBuffers": { "type": "boolean" }, "maxInstructions": { "type": [ "integer", "null" ], "minimum": 1 } }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
  }
}

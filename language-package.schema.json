{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ddf.technology/schemas/ddflang/manifest-1.0.json",
  "title": "DDF language package manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [ "schemaVersion", "engineApi", "id", "name", "packageVersion", "languageVersion", "fileExtensions", "sections" ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "engineApi": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "packageVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+){0,2}$" },
    "languageVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+){0,2}$" },
    "fileExtensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" } },
    "nativeExtensions": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "id", "publisher", "version", "sha256", "capabilities" ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "publisher": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+){0,2}$" },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*(?::[a-z][a-z0-9.-]*)*$" }
          }
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "lexicon", "grammar", "types", "semantics", "formatting", "intellisense", "runtime", "build", "standardLibrary" ],
      "properties": {
        "lexicon": { "$ref": "#/$defs/path" }, "grammar": { "$ref": "#/$defs/path" },
        "types": { "$ref": "#/$defs/path" }, "semantics": { "$ref": "#/$defs/path" },
        "formatting": { "$ref": "#/$defs/path" }, "intellisense": { "$ref": "#/$defs/path" },
        "runtime": { "$ref": "#/$defs/path" }, "build": { "$ref": "#/$defs/path" },
        "standardLibrary": { "$ref": "#/$defs/path" }
      }
    }
  },
  "$defs": { "path": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+\\.json$" } }
}

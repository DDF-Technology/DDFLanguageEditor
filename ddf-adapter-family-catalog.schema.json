{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddf.technology/schemas/ddf-adapter-family-catalog.schema.json",
  "title": "DDF governed adapter family catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "families"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": "1.0" },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/family" }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": ["complete", "required", "notApplicable"]
        },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security", "portability", "licensing", "testing"],
      "properties": {
        "security": { "$ref": "#/$defs/gate" },
        "portability": { "$ref": "#/$defs/gate" },
        "licensing": { "$ref": "#/$defs/gate" },
        "testing": { "$ref": "#/$defs/gate" }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "displayName", "classification", "stage",
        "standardLibrary", "useCases", "portability", "dependencies",
        "capabilities", "gates", "blockers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(ddf\\.(dotnet|platform)|host)\\.[a-z0-9][a-z0-9.-]*$"
        },
        "displayName": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["dotNet", "platform", "host"] },
        "stage": { "enum": ["available", "candidate", "deferred"] },
        "standardLibrary": { "const": false },
        "maintainer": { "type": ["string", "null"] },
        "useCases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "portability": {
          "enum": [
            "portable", "managedProvider", "platformSpecific",
            "hostDefined", "externalService"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "gates": { "$ref": "#/$defs/gates" },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "stage": { "const": "available" } },
            "required": ["stage"]
          },
          "then": {
            "required": ["maintainer"],
            "properties": {
              "maintainer": { "type": "string", "minLength": 1 },
              "blockers": { "maxItems": 0 },
              "gates": {
                "properties": {
                  "security": { "$ref": "#/$defs/satisfiedGate" },
                  "portability": { "$ref": "#/$defs/satisfiedGate" },
                  "licensing": { "$ref": "#/$defs/satisfiedGate" },
                  "testing": { "$ref": "#/$defs/satisfiedGate" }
                }
              }
            }
          }
        }
      ]
    },
    "satisfiedGate": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "properties": {
            "status": { "enum": ["complete", "notApplicable"] }
          }
        }
      ]
    }
  }
}

{
  "$schema": "./ddf-project-testing-design.schema.json",
  "schemaVersion": "1.0",
  "status": "accepted-design-not-implemented",
  "decisionId": "DDF-0040",
  "minimumLanguageVersion": "0.13",
  "targetEditorSdkContract": "0.39",
  "planContract": "ddf-test-plan@1.0",
  "adapter": "ddf-project-tests-v1",
  "reportContract": "ddf-test-report@1.0",
  "currentLanguagePackageTestAdapter": "ddf-tests-v1",
  "testLibrary": {
    "identity": "ddf.testing@1",
    "functions": [ "assertTrue", "assertFalse", "fail", "assertIntEqual", "assertLongEqual", "assertFloatEqual", "assertFloatNear", "assertDecimalEqual", "assertBoolEqual", "assertCharEqual", "assertStringEqual" ],
    "maximumFailuresPerCase": 128
  },
  "expectedOutcomeKinds": [ "success", "diagnostic", "recoverable-error" ],
  "caseStatusKinds": [ "passed", "failed", "error", "skipped", "infrastructure-error" ],
  "fixtureFields": [ "state", "input", "expectedOutput", "clock", "random", "capabilitySimulators", "budgets", "hostValues", "permissions" ],
  "reportIdentityFields": [ "projectFingerprint", "languageIdentity", "planFingerprint", "backendIdentity", "fixtureFingerprint" ],
  "runnerDiagnostics": [ "DDFT001", "DDFT002", "DDFT003", "DDFT004", "DDFT005", "DDFT006", "DDFT007", "DDFT008", "DDFT009", "DDFT010" ],
  "rules": {
    "testFunctionsUseOrdinaryDdfSyntax": true,
    "testSourcesCannotEnterProductionArtifacts": true,
    "productionCannotDependOnTestSources": true,
    "testLibraryAvailableOnlyInTestMode": true,
    "assertionsRecordTypedFailures": true,
    "assertionsNeverThrowClrExceptions": true,
    "approximateFloatComparisonRequiresExplicitTolerance": true,
    "engineFaultCannotBeExpectedSuccess": true,
    "messagesAndClrStacksCannotBeOracles": true,
    "emptyTestsAreRejected": true,
    "eachCaseUsesFreshState": true,
    "fixturesAreImmutableAndFingerprinted": true,
    "undeclaredCapabilitiesAreDenied": true,
    "realExternalEffectsDeniedByDefault": true,
    "simulatedEffectsAlwaysRollback": true,
    "arbitrarySetupAndTeardownInitiallyForbidden": true,
    "caseOrderCannotAffectResults": true,
    "parallelismRequiresProvenIsolation": true,
    "vmAndRoslynResultsMustMatch": true,
    "adapterFramesHiddenFromDebugger": true,
    "skipRequiresDeclaredReason": true,
    "missingProviderNeverAutoSkips": true,
    "telemetryExcludedFromOutcomeFingerprint": true
  },
  "integration": {
    "standardLibraryBindingV2Required": true,
    "typedErrorsUsedWhenAvailable": true,
    "clockAndRandomSnapshotsSupported": true,
    "hostCapabilitySimulationSupported": true,
    "editorAndCliShareReport": true,
    "debugTestSupported": true
  }
}

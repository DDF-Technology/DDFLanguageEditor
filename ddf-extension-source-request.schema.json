{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DDF extension semantic/build source request 1.0",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "pointId", "document", "ruleId", "start", "length"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "pointId": { "$ref": "#/$defs/pointId" },
        "document": { "$ref": "#/$defs/source" },
        "ruleId": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128 },
        "start": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "pointId", "entrySource", "targetKind", "sources"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "pointId": { "$ref": "#/$defs/pointId" },
        "entrySource": { "$ref": "#/$defs/relativePath" },
        "targetKind": { "enum": ["Executable", "Library"] },
        "sources": { "type": "array", "minItems": 1, "maxItems": 128,
          "items": { "$ref": "#/$defs/source" } }
      }
    }
  ],
  "$defs": {
    "pointId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 160 },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 512 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["relativePath", "sha256", "sourceText"],
      "properties": {
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceText": { "type": "string", "maxLength": 1048576 }
      }
    }
  }
}

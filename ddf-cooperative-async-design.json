{
  "$schema": "./ddf-cooperative-async-design.schema.json",
  "schemaVersion": "1.0",
  "status": "accepted-design-not-implemented",
  "decisionId": "DDF-0042",
  "targetLanguageVersion": "0.24",
  "targetEditorSdkContract": "0.41",
  "syntax": {
    "newKeywords": [],
    "ordinaryCallSyntax": true,
    "asyncIdentifierReserved": false,
    "awaitIdentifierReserved": false,
    "tasksExposedToLanguage": false
  },
  "suspensionDescriptorContract": "ddf-cooperative-suspension@1.0",
  "runtimeProviderContract": "ddf.async-capability-provider.v1",
  "executionStates": [ "idle", "running", "awaiting-capability", "cancelling", "cleaning-up" ],
  "irOperations": [ "suspend.request", "suspend.resume", "suspend.cancel", "suspend.discard" ],
  "diagnostics": [ "DDF370", "DDF371", "DDF372", "DDF373", "DDF374", "DDF375", "DDF376", "DDF377", "DDF378", "DDF379" ],
  "rules": {
    "oneActiveExecutionPerInstance": true,
    "onePendingSuspensionPerInstance": true,
    "suspensionConsumesNoThread": true,
    "continuationBoundToExecutionGeneration": true,
    "requestsAndResultsAreImmutable": true,
    "lateDuplicateAndForeignResultsCannotMutateState": true,
    "providerReentrancyIsForbidden": true,
    "concurrentStateAccessIsForbidden": true,
    "instructionBudgetPausesWhileSuspended": true,
    "deadlinesAndSuspensionQuotasContinue": true,
    "effectiveDeadlineUsesEarliestLimit": true,
    "engineCancellationIsNotCatchable": true,
    "onlyDeclaredTimeoutsMayBeRecoverable": true,
    "cleanupUsesIndependentBoundedContext": true,
    "stateCommitsAfterResumeAndCleanup": true,
    "clrTasksDelegatesAndExceptionsNeverCrossBoundary": true,
    "uiDispatcherNeverExecutesDdfInstructions": true,
    "nonCooperativeCodeRequiresWorker": true,
    "vmAndRoslynSemanticsMustMatch": true,
    "wallClockDurationIsNotDeterministicOutput": true
  },
  "integration": {
    "standardLibraryBindingV2Required": true,
    "resourceLifetimeContractRequired": true,
    "typedErrorsRequired": true,
    "versionedContinuationProtocolRequired": true,
    "debuggerStatePreserved": true,
    "flowchartStatePreserved": true,
    "standaloneAndEmbeddedShareSemantics": true,
    "embeddedRemainsCapabilityDeniedByDefault": true,
    "hostUiHeartbeatTestsRequired": true,
    "lateCallbackAndDisposeTestsRequired": true
  }
}

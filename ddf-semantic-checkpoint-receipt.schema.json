{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ddf.technology/schemas/ddf/semantic-checkpoint-receipt-1.0.json",
  "title": "DDF semantic checkpoint receipt 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "sessionId", "configuration", "startedUtc", "completedUtc", "automated", "manual", "readiness" ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "sessionId": { "type": "string", "minLength": 1 },
    "configuration": { "enum": [ "Debug", "Release" ] },
    "startedUtc": { "type": "string", "format": "date-time" },
    "completedUtc": { "type": "string", "format": "date-time" },
    "automated": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "status", "stages", "failure" ],
      "properties": {
        "status": { "enum": [ "passed", "failed" ] },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "id", "status", "exitCode", "durationMilliseconds", "log" ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "enum": [ "passed", "failed" ] },
              "exitCode": { "type": "integer" },
              "durationMilliseconds": { "type": "integer", "minimum": 0 },
              "log": { "type": "string", "minLength": 1 }
            }
          }
        },
        "failure": { "type": [ "string", "null" ] }
      }
    },
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "status", "checklist", "completedBy", "completedAt", "notes" ],
      "properties": {
        "status": { "enum": [ "pending", "passed", "failed" ] },
        "checklist": { "const": "DDF_SEMANTIC_CHECKPOINT_MANUAL_SESSION.md" },
        "completedBy": { "type": [ "string", "null" ] },
        "completedAt": { "type": [ "string", "null" ], "format": "date-time" },
        "notes": { "type": "string" }
      }
    },
    "readiness": { "enum": [ "not-ready", "ready" ] }
  }
}

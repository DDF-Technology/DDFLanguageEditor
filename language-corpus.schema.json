{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddf.technology/schemas/language-corpus-1.0.json",
  "title": "DDF normative language corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [ "schemaVersion", "languageId", "languageVersion", "languagePackageVersion", "oracleBackend", "futureBackend", "valid", "invalid", "incomplete", "multiFile" ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "languageId": { "const": "ddf" },
    "languageVersion": { "type": "string" },
    "languagePackageVersion": { "type": "string" },
    "oracleBackend": { "const": "ddf-vm-ir-v1" },
    "futureBackend": { "const": "dotnet-roslyn-v1" },
    "valid": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/validCase" } },
    "invalid": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/invalidCase" } },
    "incomplete": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/incompleteCase" } },
    "multiFile": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/multiFileCase" } }
  },
  "$defs": {
    "baseCase": {
      "type": "object",
      "required": [ "id", "file" ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "file": { "type": "string", "pattern": "^[^\\\\/]+\\.ddf$" }
      }
    },
    "validCase": {
      "allOf": [
        { "$ref": "#/$defs/baseCase" },
        {
          "type": "object",
          "required": [ "id", "file", "returnClrType", "returnValue", "output" ],
          "properties": {
            "id": { "type": "string" }, "file": { "type": "string" },
            "returnClrType": { "type": "string" }, "returnValue": { "type": "string" },
            "output": { "type": "array", "items": { "type": "string" } }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "invalidCase": {
      "allOf": [
        { "$ref": "#/$defs/baseCase" },
        {
          "type": "object",
          "required": [ "id", "file", "stage", "diagnostics" ],
          "properties": {
            "id": { "type": "string" }, "file": { "type": "string" },
            "stage": { "enum": [ "lexical", "syntax", "semantic", "runtime" ] },
            "diagnostics": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^DDF[0-9]{3}$" } }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "incompleteCase": {
      "allOf": [
        { "$ref": "#/$defs/baseCase" },
        {
          "type": "object",
          "required": [ "id", "file", "minimumDiagnostics" ],
          "properties": {
            "id": { "type": "string" }, "file": { "type": "string" },
            "minimumDiagnostics": { "type": "integer", "minimum": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "multiFileCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "id", "directory", "manifest", "status" ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "directory": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "manifest": { "const": "ddf-project.json" },
        "status": { "enum": [ "success", "diagnostic" ] },
        "returnClrType": { "type": "string" },
        "returnValue": { "type": "string" },
        "output": { "type": "array", "items": { "type": "string" } },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DDFLanguageEditor.EditorSmokeTests</RootNamespace>
    <AssemblyName>DDFLanguageEditor.EditorSmokeTests</AssemblyName>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DDF - Program Language Editor.csproj" />
    <ProjectReference Include="..\..\DDFLanguageEditor.Compiler\DDFLanguageEditor.Compiler.csproj" />
    <ProjectReference Include="..\..\DDFLanguageEditor.Runner\DDFLanguageEditor.Runner.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\samples\DDFLanguageEditor.HostDemo\DDFLanguageEditor.HostDemo.csproj" />
    <ProjectReference Include="..\..\samples\DDFLanguageEditor.DatabaseDemo\DDFLanguageEditor.DatabaseDemo.csproj" />
    <ProjectReference Include="..\..\samples\DDFLanguageEditor.MinimalHost\DDFLanguageEditor.MinimalHost.csproj" />
  </ItemGroup>

  <Target Name="CopyDdfRunner" AfterTargets="Build">
    <ItemGroup>
      <DdfRunnerFile Include="..\..\DDFLanguageEditor.Runner\bin\$(Configuration)\DDFLanguageEditor.Runner.dll" />
      <DdfRunnerFile Include="..\..\DDFLanguageEditor.Runner\bin\$(Configuration)\DDFLanguageEditor.Runner.deps.json" />
      <DdfRunnerFile Include="..\..\DDFLanguageEditor.Runner\bin\$(Configuration)\DDFLanguageEditor.Runner.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DdfRunnerFile)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="..\..\language-packages\ddf-it-didactic\*.*" Link="language-package-seeds\ddf-it-didactic\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\language-packages\ddf-c-familiar\*.*" Link="language-package-seeds\ddf-c-familiar\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

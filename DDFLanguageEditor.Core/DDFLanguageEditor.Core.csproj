<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DDFLanguageEditor.Core</RootNamespace>
    <AssemblyName>DDFLanguageEditor.Core</AssemblyName>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>0.12.5</Version>
    <FileVersion>0.12.5.0</FileVersion>
    <AssemblyVersion>0.12.5.0</AssemblyVersion>
    <InformationalVersion>0.12.5</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IsPackable>true</IsPackable>
    <PackageId>DDFLanguageEditor.Core</PackageId>
    <PackageVersion>0.12.5-beta</PackageVersion>
    <Authors>Fabio De Deo</Authors>
    <Company>DDF.Technology</Company>
    <Description>UI-independent language, analysis, build, runtime and debugging services for DDFLanguageEditor.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>DDF language parser runtime debugger SDK</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\language-packages\ddf\*.*"
                      Link="LanguagePackages\Ddf\%(Filename)%(Extension)"
                      LogicalName="DDFLanguageEditor.Core.LanguagePackages.Ddf.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\ddf-version-matrix.json"
                      Link="Versioning\ddf-version-matrix.json"
                      LogicalName="DDFLanguageEditor.Core.Versioning.ddf-version-matrix.json" />
    <EmbeddedResource Include="..\ddf-release-trust-store.json"
                      Link="ProductUpdates\ddf-release-trust-store.json"
                      LogicalName="DDFLanguageEditor.Core.ProductUpdates.ddf-release-trust-store.json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Include="..\ddf-adapter-family-catalog.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-version-matrix.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-version-matrix.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-product-update-result.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-product-update-installation-plan.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-product-update-installation-journal.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-product-update-staging-seal.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-release-manifest.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-release-trust-store.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-release-trust-store.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-extension-plugin.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-extension-plugin-signature.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-extension-plugin-lock.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-extension-points.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-extension-call.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-extension-call-response.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-extension-call-frame.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-extension-call-signatures.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-extension-source-request.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-extension-semantic-response.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-extension-build-response.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-extension-source-frame.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\DDF_EXTENSION_PLUGIN_CONTRACT.md" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-language-integration.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-language-integration.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\DDF_LANGUAGE_INTEGRATION.md" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-backend-equivalence.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\ddf-backend-equivalence.schema.json" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\DDF_BACKEND_EQUIVALENCE.md" Pack="true" PackagePath="contentFiles\any\any\" />
    <None Include="..\adapter-families\catalog.json" Pack="true" PackagePath="contentFiles\any\any\adapter-families\" />
  </ItemGroup>
</Project>

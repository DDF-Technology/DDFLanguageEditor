<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DDF___Program_Language_Editor</RootNamespace>
    <AssemblyName>DDFLanguageEditor.WinForms</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);DDFLanguageEditor.App\**;DDFLanguageEditor.Core\**;tests\**;samples\**</DefaultItemExcludes>
    <IsPackable>true</IsPackable>
    <PackageId>DDFLanguageEditor.WinForms</PackageId>
    <PackageVersion>0.11.2-beta</PackageVersion>
    <Authors>Fabio De Deo</Authors>
    <Company>DDF.Technology</Company>
    <Description>WinForms controls and full embeddable shell for DDFLanguageEditor.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>EDITOR_SDK.md</PackageReadmeFile>
    <PackageTags>DDF editor WinForms scripting embedded</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Program.cs" />
    <ProjectReference Include="DDFLanguageEditor.Core\DDFLanguageEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="LICENSE" Pack="true" PackagePath="" />
    <None Update="EDITOR_SDK.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="language-packages\ddf\*.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="language-package.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="language-lexicon.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="language-grammar.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="language-types.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="language-semantics.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="language-runtime.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="language-standard-library.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="language-build.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="language-tests.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ddf-project.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resource\DDFLanguageEditor.ico" LogicalName="DDFLanguageEditor.AppIcon.ico" />
    <EmbeddedResource Include="Resource\AppIcon.png" LogicalName="DDFLanguageEditor.AppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Main.Designer.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Editor.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Completion.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.SignatureHelp.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Snippets.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.QuickFixes.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Folding.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Formatting.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Execution.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Debugger.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Toolbar.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Semantics.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Workspace.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.WorkspaceSearch.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Navigation.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.NavigationHistory.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Breadcrumb.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.CommandPalette.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Settings.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Accessibility.cs" DependentUpon="Main.cs" />
    <Compile Update="TextBoxEditingSupport.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Palettes.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Documents.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.ContextMenu.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Selection.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.MultiSelection.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.LanguagePackage.cs" DependentUpon="Main.cs" />
    <Compile Update="LanguagePackageInfoForm.cs" DependentUpon="Main.cs" />
    <Compile Update="MultiCursorRichTextBox.cs" DependentUpon="Main.cs" />
    <EmbeddedResource Update="Main.resx" DependentUpon="Main.cs" />
    <Compile Update="Properties\Resources.Designer.cs" AutoGen="True" DependentUpon="Resources.resx" />
    <EmbeddedResource Update="Properties\Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" />
  </ItemGroup>
</Project>

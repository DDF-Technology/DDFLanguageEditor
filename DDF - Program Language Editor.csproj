<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DDF___Program_Language_Editor</RootNamespace>
    <AssemblyName>DDFLanguageEditor</AssemblyName>
    <ApplicationIcon>Resource\DDFLanguageEditor.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);DDFLanguageEditor.Core\**;tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="DDFLanguageEditor.Core\DDFLanguageEditor.Core.csproj" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resource\DDFLanguageEditor.ico" LogicalName="DDFLanguageEditor.AppIcon.ico" />
    <EmbeddedResource Include="Resource\AppIcon.png" LogicalName="DDFLanguageEditor.AppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Main.Designer.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Editor.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Completion.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Folding.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Formatting.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Execution.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Toolbar.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Semantics.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Workspace.cs" DependentUpon="Main.cs" />
    <Compile Update="Main.Palettes.cs" DependentUpon="Main.cs" />
    <EmbeddedResource Update="Main.resx" DependentUpon="Main.cs" />
    <Compile Update="Properties\Resources.Designer.cs" AutoGen="True" DependentUpon="Resources.resx" />
    <Compile Update="Properties\Settings.Designer.cs" AutoGen="True" DependentUpon="Settings.settings" DesignTimeSharedInput="True" />
    <EmbeddedResource Update="Properties\Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" />
    <None Update="Properties\Settings.settings" Generator="SettingsSingleFileGenerator" LastGenOutput="Settings.Designer.cs" />
  </ItemGroup>
</Project>

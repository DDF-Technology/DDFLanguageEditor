{
  "$schema": "./ddf-resource-lifetime-design.schema.json",
  "schemaVersion": "1.0",
  "status": "accepted-design-not-implemented",
  "decisionId": "DDF-0041",
  "targetLanguageVersion": "0.23",
  "targetEditorSdkContract": "0.40",
  "syntax": {
    "keyword": "use",
    "assignmentOperator": "<<",
    "shape": "use resource-type identifier << acquisition-expression block",
    "multipleResourcesRequireNesting": true,
    "genericDeferSupported": false
  },
  "resourceDescriptorContract": "ddf-resource-descriptor@1.0",
  "runtimeProviderContract": "ddf.resource.provider.v1",
  "handleStates": [ "active", "released" ],
  "irOperations": [ "resource.acquire", "resource.scope.enter", "resource.borrow", "resource.release" ],
  "cleanupTriggers": [ "normal", "ret", "brk", "continue", "end", "recoverable-error", "engine-fault", "timeout", "cancellation", "dispose" ],
  "diagnostics": [ "DDF360", "DDF361", "DDF362", "DDF363", "DDF364", "DDF365", "DDF366", "DDF367", "DDF368", "DDF369" ],
  "rules": {
    "acquisitionEvaluatedOnce": true,
    "failedAcquisitionCreatesNoScope": true,
    "bindingIsImmutable": true,
    "bindingIsLexicallyScoped": true,
    "handlesAreOpaqueNominalValues": true,
    "handlesAreNonCopyable": true,
    "handlesAreNonComparable": true,
    "handlesAreNonSerializable": true,
    "handlesCannotEscapeScope": true,
    "handlesCannotBeFixedStateGlobalParameterResultFieldOrElement": true,
    "borrowsMustBeDeclaredAndNonRetaining": true,
    "ownershipDoesNotGrantCapabilities": true,
    "cleanupAttemptedExactlyOnce": true,
    "cleanupOrderIsLifo": true,
    "remainingCleanupContinuesAfterFailure": true,
    "existingOutcomeHasPrecedence": true,
    "additionalCleanupFailuresAreSuppressed": true,
    "cleanupUsesIndependentBoundedContext": true,
    "stateCommitsOnlyAfterSuccessfulCleanup": true,
    "clrTypesNeverCrossLanguageBoundary": true,
    "vmAndRoslynOrderMustMatch": true,
    "debuggerHidesTokensAndNativeObjects": true,
    "currentExecutionRegistryRemainsSafetyFallback": true
  },
  "integration": {
    "typedErrorsRequired": true,
    "standardLibraryBindingV2Required": true,
    "cooperativeCancellationRequired": true,
    "asyncCleanupPrepared": true,
    "standaloneAndEmbeddedShareSemantics": true,
    "nonCooperativeNativeCodeRequiresWorker": true
  }
}

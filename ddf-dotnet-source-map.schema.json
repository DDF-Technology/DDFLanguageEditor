{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddf.technology/schemas/ddf-dotnet-source-map-1.1.json",
  "title": "DDF .NET source map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "schemaVersion", "compilationFingerprint",
    "languageProfileId", "languageProfileVersion", "documents", "symbols"
  ],
  "properties": {
    "format": { "const": "ddf-dotnet-source-map" },
    "schemaVersion": { "const": "1.1" },
    "compilationFingerprint": { "$ref": "#/$defs/hash" },
    "languageProfileId": { "$ref": "#/$defs/id" },
    "languageProfileVersion": { "$ref": "#/$defs/version" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourcePath", "sourceSha256", "generatedPath", "sequencePoints"],
        "properties": {
          "sourcePath": { "$ref": "#/$defs/path" },
          "sourceSha256": { "$ref": "#/$defs/hash" },
          "generatedPath": { "$ref": "#/$defs/path" },
          "sequencePoints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ddfStart", "ddfLength", "generatedStartLine",
                "generatedStartColumn", "generatedEndLine", "generatedEndColumn"
              ],
              "properties": {
                "ddfStart": { "type": "integer", "minimum": 0 },
                "ddfLength": { "type": "integer", "minimum": 1 },
                "generatedStartLine": { "type": "integer", "minimum": 1 },
                "generatedStartColumn": { "type": "integer", "minimum": 1 },
                "generatedEndLine": { "type": "integer", "minimum": 1 },
                "generatedEndColumn": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbolId", "name", "kind", "type", "sourcePath", "ddfStart",
          "ddfLength", "storageName", "isWritable"
        ],
        "properties": {
          "symbolId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "Structure", "Function", "Global", "Field", "Parameter", "Local"
            ]
          },
          "type": { "type": "string", "minLength": 1 },
          "sourcePath": { "$ref": "#/$defs/path" },
          "ddfStart": { "type": "integer", "minimum": 0 },
          "ddfLength": { "type": "integer", "minimum": 1 },
          "storageName": { "$ref": "#/$defs/name" },
          "isWritable": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    }
  }
}

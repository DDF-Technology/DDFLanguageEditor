{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DDF extension build response 1.0",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "pointId", "requestSha256", "status", "artifacts"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "pointId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "requestSha256": { "$ref": "#/$defs/sha256" },
        "status": { "const": "Succeeded" },
        "artifacts": { "type": "array", "minItems": 1, "maxItems": 3,
          "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "pointId", "requestSha256", "status", "errorId"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "pointId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "requestSha256": { "$ref": "#/$defs/sha256" },
        "status": { "const": "Failed" },
        "errorId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "relativePath", "sha256", "bytesBase64"],
      "properties": {
        "kind": { "enum": ["Assembly", "Symbols", "Manifest"] },
        "relativePath": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytesBase64": { "type": "string", "minLength": 4,
          "maxLength": 11184812, "contentEncoding": "base64" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ddf.technology/schemas/ddf/module-qualification-design-1.0.json",
  "title": "DDF module qualification design 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "status", "decisionId", "targetLanguageVersion", "targetProjectManifestVersion", "qualificationToken", "manifest", "grammar", "rules", "diagnostics", "integration" ],
  "properties": {
    "$schema": { "const": "./ddf-module-qualification-design.schema.json" },
    "schemaVersion": { "const": "1.0" },
    "status": { "const": "accepted-design-not-implemented" },
    "decisionId": { "const": "DDF-0031" },
    "targetLanguageVersion": { "const": "0.16" },
    "targetProjectManifestVersion": { "const": "1.3" },
    "qualificationToken": { "const": "::" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "dependencyAliasProperty", "aliasRequired", "aliasScope", "migrationRequiresConfirmation" ],
      "properties": {
        "dependencyAliasProperty": { "const": "alias" },
        "aliasRequired": { "const": true },
        "aliasScope": { "const": "consumer-module" },
        "migrationRequiresConfirmation": { "const": true }
      }
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "qualifiedName", "qualifiedType", "qualifiedEnumMember" ],
      "properties": {
        "qualifiedName": { "type": "string", "minLength": 1 },
        "qualifiedType": { "type": "string", "minLength": 1 },
        "qualifiedEnumMember": { "type": "string", "minLength": 1 }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "directDependenciesOnly", "exportsOnly", "unqualifiedExternalLookupForbidden", "transitiveLookupForbidden", "privateLookupForbidden", "wildcardImportsForbidden", "individualSymbolAliasesForbidden", "implicitReExportsForbidden", "pathDerivedNamespacesForbidden", "aliasInferenceForbidden", "duplicateAliasesRejected", "aliasesCannotBeKeywords", "bindingUsesStableSymbolIdentity" ],
      "properties": {
        "directDependenciesOnly": { "const": true },
        "exportsOnly": { "const": true },
        "unqualifiedExternalLookupForbidden": { "const": true },
        "transitiveLookupForbidden": { "const": true },
        "privateLookupForbidden": { "const": true },
        "wildcardImportsForbidden": { "const": true },
        "individualSymbolAliasesForbidden": { "const": true },
        "implicitReExportsForbidden": { "const": true },
        "pathDerivedNamespacesForbidden": { "const": true },
        "aliasInferenceForbidden": { "const": true },
        "duplicateAliasesRejected": { "const": true },
        "aliasesCannotBeKeywords": { "const": true },
        "bindingUsesStableSymbolIdentity": { "const": true }
      }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^DDF[0-9]{3}$" }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "fingerprintsIncludeAliasTable", "artifactsIncludeAliasTable", "sourceMapsPreserveQualifiedNames", "renameUpdatesManifestAndConsumerSources", "installedModuleSourcesRemainReadOnly" ],
      "properties": {
        "fingerprintsIncludeAliasTable": { "const": true },
        "artifactsIncludeAliasTable": { "const": true },
        "sourceMapsPreserveQualifiedNames": { "const": true },
        "renameUpdatesManifestAndConsumerSources": { "const": true },
        "installedModuleSourcesRemainReadOnly": { "const": true }
      }
    }
  }
}

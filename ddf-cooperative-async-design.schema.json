{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ddf.technology/schemas/ddf/cooperative-async-design-1.0.json",
  "title": "DDF cooperative async design 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "status", "decisionId", "targetLanguageVersion", "targetEditorSdkContract", "syntax", "suspensionDescriptorContract", "runtimeProviderContract", "executionStates", "irOperations", "diagnostics", "rules", "integration" ],
  "properties": {
    "$schema": { "const": "./ddf-cooperative-async-design.schema.json" },
    "schemaVersion": { "const": "1.0" },
    "status": { "const": "accepted-design-not-implemented" },
    "decisionId": { "const": "DDF-0042" },
    "targetLanguageVersion": { "const": "0.24" },
    "targetEditorSdkContract": { "const": "0.41" },
    "syntax": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "newKeywords", "ordinaryCallSyntax", "asyncIdentifierReserved", "awaitIdentifierReserved", "tasksExposedToLanguage" ],
      "properties": {
        "newKeywords": { "type": "array", "maxItems": 0 },
        "ordinaryCallSyntax": { "const": true },
        "asyncIdentifierReserved": { "const": false },
        "awaitIdentifierReserved": { "const": false },
        "tasksExposedToLanguage": { "const": false }
      }
    },
    "suspensionDescriptorContract": { "const": "ddf-cooperative-suspension@1.0" },
    "runtimeProviderContract": { "const": "ddf.async-capability-provider.v1" },
    "executionStates": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "irOperations": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "diagnostics": {
      "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^DDF3[0-9]{2}$" }
    },
    "rules": { "$ref": "#/$defs/allTrueObject" },
    "integration": { "$ref": "#/$defs/allTrueObject" }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allTrueObject": {
      "type": "object", "minProperties": 1,
      "additionalProperties": { "const": true }
    }
  }
}

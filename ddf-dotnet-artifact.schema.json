{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddf.technology/schemas/ddf-dotnet-artifact-1.1.json",
  "title": "DDF .NET artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "schemaVersion", "moduleId", "moduleVersion",
    "compilationUnitVersion", "compilationFingerprint", "irFormatVersion",
    "languageId", "languagePackageVersion", "backendId", "targetFramework",
    "runtimeIdentifier", "runtimeAbiVersion", "assemblyName", "buildReceipt",
    "requiredHostCapabilities", "exports", "imports", "dependencies", "payloads"
  ],
  "properties": {
    "format": { "const": "ddf-dotnet-artifact" },
    "schemaVersion": { "const": "1.1" },
    "moduleId": { "$ref": "#/$defs/id" },
    "moduleVersion": { "$ref": "#/$defs/version" },
    "compilationUnitVersion": { "const": "1.0" },
    "compilationFingerprint": { "$ref": "#/$defs/hash" },
    "irFormatVersion": { "const": "1.0" },
    "languageId": { "$ref": "#/$defs/id" },
    "languagePackageVersion": { "$ref": "#/$defs/version" },
    "backendId": { "const": "dotnet-roslyn" },
    "targetFramework": { "type": "string", "minLength": 1 },
    "runtimeIdentifier": {
      "type": "string",
      "pattern": "^(?:|[A-Za-z0-9][A-Za-z0-9.-]*)$"
    },
    "runtimeAbiVersion": { "$ref": "#/$defs/version" },
    "assemblyName": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
    "buildReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compilationPlanVersion", "compilationPlanFingerprint",
        "compilerProfileVersion", "roslynVersion", "cSharpLanguageVersion",
        "referenceSetFingerprint"
      ],
      "properties": {
        "compilationPlanVersion": { "const": "1.0" },
        "compilationPlanFingerprint": { "$ref": "#/$defs/hash" },
        "compilerProfileVersion": { "const": "1.0" },
        "roslynVersion": { "type": "string", "minLength": 1 },
        "cSharpLanguageVersion": { "const": "CSharp14" },
        "referenceSetFingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "requiredHostCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "signature"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "kind": { "enum": ["Function", "Structure", "Global"] },
          "signature": { "type": "string", "minLength": 1 }
        }
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moduleId", "moduleVersion", "name", "kind", "signature"],
        "properties": {
          "moduleId": { "$ref": "#/$defs/id" },
          "moduleVersion": { "$ref": "#/$defs/version" },
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "kind": { "enum": ["Function", "Structure", "Global"] },
          "signature": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moduleId", "moduleVersion", "compilationFingerprint", "assemblyName"],
        "properties": {
          "moduleId": { "$ref": "#/$defs/id" },
          "moduleVersion": { "$ref": "#/$defs/version" },
          "compilationFingerprint": { "$ref": "#/$defs/hash" },
          "assemblyName": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" }
        }
      }
    },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "size"],
        "properties": {
          "kind": { "enum": ["Assembly", "PortablePdb", "SourceMap"] },
          "path": { "$ref": "#/$defs/path" },
          "sha256": { "$ref": "#/$defs/hash" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    }
  }
}

{
  "$schema": "./ddf-math-library-design.schema.json",
  "schemaVersion": "1.0",
  "status": "accepted-design-not-implemented",
  "decisionId": "DDF-0036",
  "targetLanguageVersion": "0.21",
  "targetStandardLibraryVersion": "0.21.0",
  "transcendentalAlgorithm": "ddf.math.transcendental.v1",
  "angleUnit": "radian",
  "functions": [ "absInt", "absLong", "absFloat", "absDecimal", "minInt", "minLong", "minFloat", "minDecimal", "maxInt", "maxLong", "maxFloat", "maxDecimal", "clampInt", "clampLong", "clampFloat", "clampDecimal", "floorFloat", "ceilingFloat", "truncateFloat", "roundFloat", "roundDecimal", "sqrt", "powerFloat", "exp", "log", "log10", "sin", "cos", "tan", "asin", "acos", "atan", "atan2", "pi", "e" ],
  "domains": {
    "sqrt": "x>=0",
    "log": "x>0",
    "log10": "x>0",
    "asin": "-1<=x<=1",
    "acos": "-1<=x<=1",
    "powerFloat": "base>=0 || exponent-is-exact-integer",
    "roundFloatDigits": "0..15",
    "roundDecimalDigits": "0..28"
  },
  "rules": {
    "overloadsForbidden": true,
    "functionsArePure": true,
    "argumentsEvaluateLeftToRightOnce": true,
    "integerAbsoluteValueIsChecked": true,
    "signedZeroRulesAreExplicit": true,
    "clampRequiresOrderedBounds": true,
    "roundingIsNearestTiesToEven": true,
    "zeroPowerZeroIsOne": true,
    "nonFiniteInputsForbidden": true,
    "nonFiniteResultsForbidden": true,
    "fixedCallsInitiallyForbidden": true,
    "randomnessAndTimeExcluded": true,
    "directPlatformMathForbidden": true
  },
  "constants": {
    "piBinary64Hex": "400921fb54442d18",
    "eBinary64Hex": "4005bf0a8b145769"
  },
  "diagnostics": [ "DDF358", "DDF359", "DDF360", "DDF361", "DDF362" ],
  "integration": {
    "extendedNumericsRequired": true,
    "irUsesDdfMathOperations": true,
    "referenceVectorsRequired": true,
    "binary64ResultsMustMatch": true,
    "vmRoslynAndFutureVmMustBeEquivalent": true
  }
}

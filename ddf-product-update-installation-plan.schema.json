{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ddf.technology/schemas/product-update-installation-plan-1.0.json",
  "title": "DDF product update installation plan 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "protocolVersion", "installationId", "componentId",
    "currentVersion", "targetVersion", "runtimeIdentifier", "architecture",
    "manifestSha256", "signingKeyId", "assetUri", "assetSize", "assetSha256",
    "targetRoot", "stagingRoot", "backupRoot", "applicationExecutable",
    "parentProcessId", "parentProcessStartedUtc", "nonce", "restartRequested",
    "inventory", "createdUtc"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "protocolVersion": { "const": "1.0" },
    "installationId": { "$ref": "#/$defs/id" },
    "componentId": { "$ref": "#/$defs/id" },
    "currentVersion": { "$ref": "#/$defs/semver" },
    "targetVersion": { "$ref": "#/$defs/semver" },
    "runtimeIdentifier": { "$ref": "#/$defs/token" },
    "architecture": { "$ref": "#/$defs/token" },
    "manifestSha256": { "$ref": "#/$defs/hash" },
    "signingKeyId": { "$ref": "#/$defs/id" },
    "assetUri": { "type": "string", "format": "uri", "pattern": "^https://" },
    "assetSize": { "type": "integer", "minimum": 1 },
    "assetSha256": { "$ref": "#/$defs/hash" },
    "targetRoot": { "type": "string", "minLength": 1 },
    "stagingRoot": { "type": "string", "minLength": 1 },
    "backupRoot": { "type": "string", "minLength": 1 },
    "applicationExecutable": { "$ref": "#/$defs/relativePath" },
    "parentProcessId": { "type": "integer", "minimum": 1 },
    "parentProcessStartedUtc": { "type": "string", "format": "date-time" },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{32,128}$" },
    "restartRequested": { "type": "boolean" },
    "inventory": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [ "relativePath", "size", "sha256" ],
        "properties": {
          "relativePath": { "$ref": "#/$defs/relativePath" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "createdUtc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "token": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^[^:/\\\\]+(?:/[^:/\\\\]+)*$" }
  }
}

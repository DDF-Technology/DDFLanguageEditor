{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ddf.technology/schemas/release-trust-store-1.0.json",
  "title": "DDF release trust store",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "keys" ],
  "properties": {
    "$schema": { "type": "string", "const": "./ddf-release-trust-store.schema.json" },
    "schemaVersion": { "type": "string", "const": "1.0" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "keyId", "algorithm", "publicKeySpkiBase64", "sha256", "status" ],
        "properties": {
          "keyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "algorithm": { "type": "string", "const": "ECDSA-P256-SHA256" },
          "publicKeySpkiBase64": { "type": "string", "minLength": 80, "maxLength": 256 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "status": { "type": "string", "enum": [ "active", "revoked" ] }
        }
      }
    }
  }
}

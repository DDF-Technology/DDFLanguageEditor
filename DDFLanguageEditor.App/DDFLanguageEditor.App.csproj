<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DDF___Program_Language_Editor</RootNamespace>
    <AssemblyName>DDFLanguageEditor</AssemblyName>
    <ApplicationIcon>..\Resource\DDFLanguageEditor.ico</ApplicationIcon>
    <Version>0.12.7</Version>
    <FileVersion>0.12.7.0</FileVersion>
    <AssemblyVersion>0.12.7.0</AssemblyVersion>
    <InformationalVersion>0.12.7</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>DDF.Technology</Company>
    <Product>DDFLanguageEditor</Product>
    <Description>Experimental syntax editor for the draft DDF language</Description>
    <Copyright>Copyright © 2026 Fabio De Deo</Copyright>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDF - Program Language Editor.csproj" />
    <ProjectReference Include="..\DDFLanguageEditor.Compiler\DDFLanguageEditor.Compiler.csproj" />
    <ProjectReference Include="..\DDFLanguageEditor.Runner\DDFLanguageEditor.Runner.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyDdfRunner" AfterTargets="Build" Condition="'$(SkipDdfRunnerCopy)' != 'true'">
    <ItemGroup>
      <DdfRunnerFile Include="..\DDFLanguageEditor.Runner\bin\$(Configuration)\DDFLanguageEditor.Runner.dll" />
      <DdfRunnerFile Include="..\DDFLanguageEditor.Runner\bin\$(Configuration)\DDFLanguageEditor.Runner.deps.json" />
      <DdfRunnerFile Include="..\DDFLanguageEditor.Runner\bin\$(Configuration)\DDFLanguageEditor.Runner.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DdfRunnerFile)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ddf-version-matrix.json" Link="ddf-version-matrix.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ddf-version-matrix.schema.json" Link="ddf-version-matrix.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ddf-product-update-result.schema.json" Link="ddf-product-update-result.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ddf-release-manifest.schema.json" Link="ddf-release-manifest.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ddf-release-trust-store.json" Link="ddf-release-trust-store.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ddf-release-trust-store.schema.json" Link="ddf-release-trust-store.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ddf-language-integration.json" Link="ddf-language-integration.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ddf-language-integration.schema.json" Link="ddf-language-integration.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ddf-backend-equivalence.json" Link="ddf-backend-equivalence.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ddf-backend-equivalence.schema.json" Link="ddf-backend-equivalence.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\DDF_BACKEND_EQUIVALENCE.md" Link="DDF_BACKEND_EQUIVALENCE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\language-packages\ddf-it-didactic\*.*" Link="language-package-seeds\ddf-it-didactic\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\language-packages\ddf-c-familiar\*.*" Link="language-package-seeds\ddf-c-familiar\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ddf.technology/schemas/ddf-extension-plugin-lock-1.0.json",
  "title": "DDF extension plug-in dependency lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "publisher", "version", "assemblySha256", "manifestSha256"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "publisher": { "$ref": "#/$defs/identifier" },
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
          "assemblySha256": { "$ref": "#/$defs/sha256" },
          "manifestSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
  }
}

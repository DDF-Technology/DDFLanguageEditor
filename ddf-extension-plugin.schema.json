{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ddf.technology/schemas/ddf-extension-plugin-1.0.json",
  "title": "DDF extension plug-in manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "publisher", "version", "minimumSdkContract", "maximumSdkContract", "assemblyFile", "assemblySha256", "dependencies", "capabilities"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/identifier" },
    "publisher": { "$ref": "#/$defs/identifier" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "minimumSdkContract": { "$ref": "#/$defs/contract" },
    "maximumSdkContract": { "$ref": "#/$defs/contract" },
    "assemblyFile": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.[dD][lL][lL]$" },
    "assemblySha256": { "$ref": "#/$defs/sha256" },
    "dependencies": { "type": "array", "uniqueItems": true, "maxItems": 64, "items": { "$ref": "#/$defs/identifier" } },
    "capabilities": { "type": "array", "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "enum": ["device.configure", "device.read", "device.write", "file.delete", "file.list", "file.read", "file.write", "native.invoke", "native.load", "network.connect", "network.listen", "network.publish", "network.subscribe", "process.inspect", "process.signal", "process.start", "ui.command", "ui.dialog", "ui.panel"] } }
  },
  "$defs": {
    "identifier": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "contract": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
  }
}

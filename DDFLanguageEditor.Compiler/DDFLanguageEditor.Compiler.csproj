<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DDFLanguageEditor.Compiler</RootNamespace>
    <AssemblyName>DDFLanguageEditor.Compiler</AssemblyName>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>0.13.0</Version>
    <FileVersion>0.13.0.0</FileVersion>
    <AssemblyVersion>0.13.0.0</AssemblyVersion>
    <InformationalVersion>0.13.0-alpha</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDFLanguageEditor.Core\DDFLanguageEditor.Core.csproj" />
    <ProjectReference Include="..\DDFLanguageEditor.Runtime\DDFLanguageEditor.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Resource\DDFLanguageEditor.ico"
                      LogicalName="DDFLanguageEditor.Compiler.DefaultAppIcon.ico" />
  </ItemGroup>
</Project>

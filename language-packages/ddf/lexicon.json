{
  "schemaVersion": "1.0",
  "adapter": "ddf-lexicon-v1",
  "lexical": {
    "whitespace": {
      "unicodeWhitespace": true,
      "characters": ""
    },
    "identifier": {
      "start": {
        "unicodeLetters": true,
        "characters": "_"
      },
      "part": {
        "unicodeLetters": true,
        "unicodeDigits": true,
        "characters": "_"
      }
    },
    "number": {
      "digits": {
        "unicodeDigits": false,
        "characters": "0123456789"
      },
      "decimalSeparator": ".",
      "requireFractionDigits": true
    },
    "delimitedTokens": [
      {
        "tokenKind": "LineComment",
        "start": "//",
        "endsAtLineBreak": true
      },
      {
        "tokenKind": "BlockComment",
        "start": "/*",
        "end": "*/",
        "allowLineBreak": true,
        "unterminatedCode": "DDF002",
        "unterminatedMessage": "Commento a blocchi non terminato."
      },
      {
        "tokenKind": "LibraryDirective",
        "start": "@@'",
        "end": "'",
        "allowLineBreak": false,
        "unterminatedCode": "DDF003",
        "unterminatedMessage": "Inclusione di libreria non terminata."
      },
      {
        "tokenKind": "StringLiteral",
        "start": "\"",
        "end": "\"",
        "allowLineBreak": false,
        "escapeCharacter": "\\",
        "allowedEscapeCharacters": "\"\\nrt",
        "unterminatedCode": "DDF001",
        "unterminatedMessage": "Stringa non terminata."
      }
    ],
    "longestMatch": true
  },
  "keywords": [
    { "text": "int", "tokenKind": "DataTypeKeyword", "role": "None" },
    { "text": "float", "tokenKind": "DataTypeKeyword", "role": "None" },
    { "text": "char", "tokenKind": "DataTypeKeyword", "role": "None" },
    { "text": "bool", "tokenKind": "DataTypeKeyword", "role": "None" },
    { "text": "void", "tokenKind": "DataTypeKeyword", "role": "None" },
    { "text": "string", "tokenKind": "DataTypeKeyword", "role": "None" },
    { "text": "dict", "tokenKind": "DataTypeKeyword", "role": "None" },
    { "text": "struct", "tokenKind": "DataTypeKeyword", "role": "Structure" },
    { "text": "ret", "tokenKind": "FunctionKeyword", "role": "Return" },
    { "text": "brk", "tokenKind": "FunctionKeyword", "role": "Break" },
    { "text": "end", "tokenKind": "FunctionKeyword", "role": "End" },
    { "text": "out", "tokenKind": "FunctionKeyword", "role": "ReturnTypeMarker" },
    { "text": "if", "tokenKind": "ControlFlowKeyword", "role": "If" },
    { "text": "else", "tokenKind": "ControlFlowKeyword", "role": "Else" },
    { "text": "while", "tokenKind": "ControlFlowKeyword", "role": "While" },
    { "text": "do", "tokenKind": "ControlFlowKeyword", "role": "Do" },
    { "text": "for", "tokenKind": "ControlFlowKeyword", "role": "For" }
  ],
  "booleanLiterals": [ "true", "false" ],
  "operators": [
    { "text": "<<", "binaryPrecedence": 1, "associativity": "Right", "role": "DeclarationInitializer" },
    { "text": ">>", "binaryPrecedence": 1, "associativity": "Right", "role": "None" },
    { "text": "||", "binaryPrecedence": 2, "associativity": "Left", "role": "None" },
    { "text": "^^", "binaryPrecedence": 3, "associativity": "Left", "role": "None" },
    { "text": "&&", "binaryPrecedence": 4, "associativity": "Left", "role": "None" },
    { "text": "==", "binaryPrecedence": 5, "associativity": "Left", "role": "None" },
    { "text": "!=", "binaryPrecedence": 5, "associativity": "Left", "role": "None" },
    { "text": "<", "binaryPrecedence": 6, "associativity": "Left", "role": "None" },
    { "text": "<=", "binaryPrecedence": 6, "associativity": "Left", "role": "None" },
    { "text": ">", "binaryPrecedence": 6, "associativity": "Left", "role": "None" },
    { "text": ">=", "binaryPrecedence": 6, "associativity": "Left", "role": "None" },
    { "text": "+", "binaryPrecedence": 7, "associativity": "Left", "prefixPrecedence": 10, "role": "None" },
    { "text": "-", "binaryPrecedence": 7, "associativity": "Left", "prefixPrecedence": 10, "role": "None" },
    { "text": "*", "binaryPrecedence": 8, "associativity": "Left", "role": "None" },
    { "text": "/", "binaryPrecedence": 8, "associativity": "Left", "role": "None" },
    { "text": "^", "binaryPrecedence": 9, "associativity": "Right", "role": "None" },
    { "text": "!", "prefixPrecedence": 10, "associativity": "Right", "role": "None" },
    { "text": "++", "postfixPrecedence": 11, "associativity": "Left", "role": "None" },
    { "text": "--", "postfixPrecedence": 11, "associativity": "Left", "role": "None" }
  ],
  "punctuation": [ "{", "}", "(", ")", "[", "]", ".", ",", ";" ]
}

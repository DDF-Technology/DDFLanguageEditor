{
  "schemaVersion": "1.0",
  "adapter": "ddf-formatter-v1",
  "dependsOn": [ "lexicon", "grammar" ],
  "tokens": {
    "blockOpen": "{", "blockClose": "}",
    "groupOpen": "(", "groupClose": ")",
    "indexOpen": "[", "indexClose": "]",
    "statementTerminator": ";", "separator": ","
  },
  "autoPairs": [
    { "open": "(", "close": ")" }, { "open": "[", "close": "]" },
    { "open": "{", "close": "}" }, { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "indentAfter": [ "{", "(" ],
  "blankLineBetweenStatements": true,
  "quickFixes": [
    { "diagnosticCode": "DDF001", "title": "Chiudi la stringa con \"", "replacement": "\"" },
    { "diagnosticCode": "DDF002", "title": "Chiudi il commento con */", "replacement": "*/" },
    { "diagnosticCode": "DDF003", "title": "Chiudi la direttiva libreria con '", "replacement": "'" }
  ],
  "description": "Regole dichiarative di layout, indentazione, coppie e correzioni lessicali."
}

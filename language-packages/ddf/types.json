{
  "schemaVersion": "1.1",
  "adapter": "ddf-types-v1",
  "dependsOn": [ "grammar" ],
  "primitives": [
    { "name": "int", "category": "Integer", "canDeclareVariable": true },
    { "name": "float", "category": "Floating", "canDeclareVariable": true },
    { "name": "char", "category": "Character", "canDeclareVariable": true },
    { "name": "bool", "category": "Boolean", "canDeclareVariable": true },
    { "name": "void", "category": "Void", "canDeclareVariable": false },
    { "name": "string", "category": "String", "canDeclareVariable": true, "indexedElementType": "char" }
  ],
  "conversions": [
    { "from": "int", "to": "float", "context": "General" },
    { "from": "string", "to": "char", "context": "VariableInitializerSingleCharacterLiteral" }
  ],
  "compatibility": { "arraysInvariant": true, "userTypesNominal": true, "errorTypeCompatible": true },
  "mutability": {
    "variablesMutable": true,
    "parametersMutable": true,
    "fieldsMutable": true,
    "assignmentTargets": [ "Name", "Index", "Member" ]
  },
  "scopes": {
    "functionParameters": true,
    "blocks": true,
    "forInitializers": true,
    "structureFields": true,
    "allowShadowing": false
  },
  "signatures": {
    "exactArity": true,
    "requireReturnForNonVoid": true,
    "voidType": "void",
    "parameterOrder": "declared"
  },
  "literals": { "integer": "int", "decimal": "float", "boolean": "bool", "string": "string" },
  "numeric": { "resultType": "int", "dominantType": "float" },
  "indexing": { "indexType": "int" },
  "clrMapping": {
    "backend": "dotnet-roslyn-v1",
    "mappingVersion": "1.0",
    "arrayRepresentation": "SZArray",
    "structureRepresentation": "SealedClass",
    "primitives": [
      { "type": "int", "clrType": "System.Int32", "csharpType": "int" },
      { "type": "float", "clrType": "System.Double", "csharpType": "double" },
      { "type": "char", "clrType": "System.Char", "csharpType": "char" },
      { "type": "bool", "clrType": "System.Boolean", "csharpType": "bool" },
      { "type": "void", "clrType": "System.Void", "csharpType": "void" },
      { "type": "string", "clrType": "System.String", "csharpType": "string" }
    ]
  },
  "description": "Tipi, conversioni, compatibilità, mutabilità, scope e firme DDF correnti."
}

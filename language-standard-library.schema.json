{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ddf.technology/schemas/ddflang/standard-library-1.0.json",
  "title": "DDF language package standard library 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [ "schemaVersion", "adapter", "functions" ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "adapter": { "const": "ddf-standard-library-v2" },
    "dependsOn": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string" },
    "functions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [ "name", "returnType", "parameterTypes", "documentation", "binding" ],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "returnType": { "$ref": "#/$defs/name" },
          "parameterTypes": { "type": "array", "items": { "$ref": "#/$defs/name" } },
          "documentation": { "type": "string" },
          "binding": { "enum": [ "host.output", "host.input", "core.string-length", "core.to-int", "core.to-float" ] }
        }
      }
    }
  },
  "$defs": { "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" } }
}

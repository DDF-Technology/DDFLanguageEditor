<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DDFLanguageEditor.Cli</RootNamespace>
    <AssemblyName>ddf</AssemblyName>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>0.13.3</Version>
    <AssemblyVersion>0.13.3.0</AssemblyVersion>
    <FileVersion>0.13.3.0</FileVersion>
    <InformationalVersion>0.13.3</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDFLanguageEditor.Compiler\DDFLanguageEditor.Compiler.csproj" />
    <ProjectReference Include="..\DDFLanguageEditor.Core\DDFLanguageEditor.Core.csproj" />
    <ProjectReference Include="..\DDFLanguageEditor.Runner\DDFLanguageEditor.Runner.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DDFLanguageEditor.Runtime\DDFLanguageEditor.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ddf.technology/schemas/ddf/language-version-policy-1.0.json",
  "title": "DDF language version policy 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [ "schemaVersion", "languageId", "languageVersion", "packageVersion", "stability", "versionDomains", "releaseRules", "compatibility", "deprecations", "migrations" ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "languageId": { "const": "ddf" },
    "languageVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "packageVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "stability": { "enum": [ "beta", "candidate", "stable" ] },
    "versionDomains": {
      "type": "array", "minItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [ "id", "owner", "format", "compatibility" ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "owner": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "minLength": 1 },
          "compatibility": { "type": "string", "minLength": 1 }
        }
      }
    },
    "releaseRules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [ "change", "languageBump", "packageBump" ],
        "properties": {
          "change": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "languageBump": { "enum": [ "none", "minor", "major" ] },
          "packageBump": { "enum": [ "patch", "minor", "major" ] }
        }
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": [ "projectPackage", "moduleDependency", "profileEquivalence", "unknownVersions" ],
      "properties": {
        "projectPackage": { "const": "exact" },
        "moduleDependency": { "const": "exact" },
        "profileEquivalence": { "const": "same-language-and-semantic-contract" },
        "unknownVersions": { "const": "reject-before-activation" }
      }
    },
    "deprecations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [ "id", "status", "deprecatedIn", "replacement", "removal", "automaticMigration" ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "status": { "const": "deprecated" },
          "deprecatedIn": { "type": "string" },
          "replacement": { "type": "string", "minLength": 1 },
          "removal": { "type": "string", "minLength": 1 },
          "automaticMigration": { "type": "boolean" }
        }
      }
    },
    "migrations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [ "id", "scope", "classification", "automation", "availability", "requiresPreview", "requiresBackup" ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "scope": { "enum": [ "source", "project-manifest" ] },
          "classification": { "enum": [ "syntax-preserving", "semantic-review" ] },
          "automation": { "enum": [ "candidate", "manual" ] },
          "availability": { "const": "specified-not-implemented" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "requiresPreview": { "type": "boolean" },
          "requiresBackup": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
